# ORCA Marine Engine Environment Configuration (copy to .env to override defaults)
HOST=0.0.0.0
PORT=8000

# Local LLM via Ollama. If OLLAMA_MODEL is not pulled, the first pulled model
# from OLLAMA_FALLBACK_MODELS is used automatically.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_FALLBACK_MODELS=llama3.2:3b,gemma3:1b,llama3.2:1b,gemma2:2b
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=1h
